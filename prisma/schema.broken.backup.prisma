// ============================================================
// RCENTZ WORKSPACE RUNTIME
// ============================================================

model Workspace {
  id   String @id @default(cuid())
  slug String @unique
  name String

  mode WorkspaceMode @default(LIVE)

  active     Boolean @default(true)
  resettable Boolean @default(false)

  expiresAt DateTime?

  memberships WorkspaceMembership[]
  demoWallets DemoWallet[]
  events      ExperienceEvent[]
  provisions  DemoProvision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mode, active])
  @@map("workspace")
}

model WorkspaceMembership {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   WorkspaceRole @default(MEMBER)
  active Boolean       @default(true)

  joinedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_membership")
}

model DemoWallet {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  currency String  @default("NGN")
  balance  Decimal @default(500000) @db.Decimal(14, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("demo_wallet")
}

model ExperienceEvent {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessionId String?

  type       ExperienceEventType
  source     String?
  dataSource DataSource @default(REAL)

  productId    String?
  categorySlug String?
  collectionId String?
  campaignId   String?
  searchTerm   String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, type, createdAt])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("experience_event")
}

model DemoScenario {
  id   String @id @default(cuid())
  slug String @unique
  name String

  type DemoScenarioType

  description   String?
  configuration Json?

  active Boolean @default(true)

  provisions DemoProvision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("demo_scenario")
}

model DemoProvision {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  scenarioId String
  scenario   DemoScenario @relation(fields: [scenarioId], references: [id])

  status DemoProvisionStatus @default(PENDING)

  seededRecords Int @default(0)

  metadata    Json?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([scenarioId])
  @@index([status])
  @@map("demo_provision")
}