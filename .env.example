# Database and authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Google authentication (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paystack test mode only. Never expose this value through NEXT_PUBLIC_*.
PAYSTACK_SECRET_KEY="sk_test_replace_with_your_paystack_test_secret"
# Optional. Paystack appends ?reference=... to this URL after checkout.
PAYSTACK_CALLBACK_URL="http://localhost:3000/payments"
